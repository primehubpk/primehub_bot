DATABASE_URL=postgresql://postgres:postgres@localhost:5432/primehub_bot
ADMIN_PASSWORD=change-me
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Configure either provider. App still loads without these and chat shows a friendly config error.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Phase 3+ email. Orders/reseller approvals still save if SMTP is blank.
OPS_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Phase 4 knowledge buttons. Replace with real site URLs when Phase 5 embeds the widget.
PRIME_SKILL_URL=/prime-skill
RESELLER_CLUB_URL=/reseller-club
