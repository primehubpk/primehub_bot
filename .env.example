DATABASE_URL=postgresql://postgres:postgres@localhost:5432/primehub_bot
DATABASE_SSL=false
ADMIN_PASSWORD=change-me
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOWED_WEBSITE_ORIGINS=http://localhost:3001,https://primehubmall.com,https://www.primehubmall.com

# Configure either provider. App still loads without these and chat shows a friendly config error.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Orders/reseller approvals still save if SMTP is blank.
OPS_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# PrimeHub website feature links shown by Salaar.
PRIME_SKILL_URL=https://www.primehubmall.com/prime-skill
RESELLER_CLUB_URL=https://www.primehubmall.com/reseller-club
