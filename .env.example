DATABASE_URL=postgresql://postgres:postgres@localhost:5432/primehub_bot
DATABASE_SSL=false
ADMIN_PASSWORD=change-me
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOWED_WEBSITE_ORIGINS=http://localhost:3001,https://primehubmall.com,https://www.primehubmall.com

# Salaar LLM providers. Multiple keys may be comma/newline/semicolon separated.
# Salaar rotates the starting key and automatically fails over to the next key/provider.
# OpenAI and DeepSeek are intentionally not used in the active Salaar provider chain.
GROQ_API_KEYS=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEYS=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

GEMINI_API_KEYS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Orders/reseller approvals still save if SMTP is blank.
OPS_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# PrimeHub website feature links shown by Salaar.
PRIME_SKILL_URL=https://www.primehubmall.com/prime-skill
RESELLER_CLUB_URL=https://www.primehubmall.com/reseller-club
